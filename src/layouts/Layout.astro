---
import "../styles/calkie.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cal-Kie — Your week, your workout",
  description = "Build a personalised weekly workout plan with AI."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101713" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <dialog class="account-dialog" id="calkie-account-dialog" aria-labelledby="calkie-account-title">
      <div class="account-dialog-head">
        <div><p class="eyebrow">YOUR CAL-KIE ACCOUNT</p><h2 id="calkie-account-title">Your training, saved.</h2></div>
        <button class="account-close" type="button" data-close-account aria-label="Close">×</button>
      </div>
      <p class="account-intro" id="calkie-account-status" role="status" aria-live="polite">Create an account or log in to sync your workout plans.</p>
      <div id="calkie-account-profile" hidden><p class="account-profile-email" id="calkie-account-profile-email"></p></div>
      <form id="calkie-account-form">
        <div id="calkie-account-fields">
          <label class="account-field" id="calkie-account-name-label">Your name<input id="calkie-account-name" type="text" autocomplete="name" maxlength="80" placeholder="Your name" /></label>
          <label class="account-field">Email address<input id="calkie-account-email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
          <label class="account-field">Password<input id="calkie-account-password" type="password" minlength="8" autocomplete="new-password" required placeholder="At least 8 characters" /></label>
          <label class="account-field" id="calkie-account-confirm-label" hidden>Confirm new password<input id="calkie-account-confirm" type="password" minlength="8" autocomplete="new-password" /></label>
        </div>
        <div class="account-form-actions"><button class="button button-primary" id="calkie-account-submit" type="submit">Create account</button></div>
      </form>
      <div class="account-links"><button type="button" id="calkie-account-toggle">Already have an account? Log in</button><button type="button" id="calkie-account-forgot" hidden>Forgot password?</button></div>
      <div id="calkie-account-session-actions" hidden><button class="button button-quiet" id="calkie-account-signout" type="button">Log out</button></div>
    </dialog>
    <script>import "../scripts/account";</script>
  </body>
</html>
