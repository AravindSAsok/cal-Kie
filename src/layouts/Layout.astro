---
import "../styles/calkie.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cal-Kie — Your week, your workout",
  description = "Build a personalised weekly workout plan with AI."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101713" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
