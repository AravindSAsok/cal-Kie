---
import Layout from "../layouts/Layout.astro";
import AppChrome from "../components/AppChrome.astro";
---

<Layout title="Timer — Cal-Kie" description="A focused countdown, stopwatch and interval timer for your workouts and everyday tasks.">
  <AppChrome active="timer">
    <div class="timer-page">
      <div class="timer-intro">
        <p class="eyebrow">Focus your time</p>
        <h1>Your time.<br /><em>Your pace.</em></h1>
        <p>Count down a rest period, track a whole session or run your own work-and-rest intervals. No account needed.</p>
      </div>

      <section class="timer-card" aria-label="Timer tools">
        <div class="timer-tabs" role="tablist" aria-label="Choose timer">
          <button type="button" class="timer-tab active" data-mode="countdown" role="tab" aria-selected="true">Countdown</button>
          <button type="button" class="timer-tab" data-mode="stopwatch" role="tab" aria-selected="false">Stopwatch</button>
          <button type="button" class="timer-tab" data-mode="interval" role="tab" aria-selected="false">Intervals</button>
        </div>

        <section class="timer-panel" id="panel-countdown" role="tabpanel">
          <div class="timer-mode-heading">
            <div><span class="timer-kicker">SET A DURATION</span><h2>Countdown timer</h2></div>
            <span class="timer-status" id="countdown-status">Ready</span>
          </div>
          <div class="timer-display" id="countdown-display" aria-live="off">05:00</div>
          <div class="timer-inputs">
            <label>Minutes<input id="countdown-minutes" type="number" min="0" max="599" value="5" inputmode="numeric" /></label>
            <span aria-hidden="true">:</span>
            <label>Seconds<input id="countdown-seconds" type="number" min="0" max="59" value="0" inputmode="numeric" /></label>
          </div>
          <div class="timer-presets" aria-label="Quick durations">
            <button type="button" data-preset="60">1 min</button>
            <button type="button" data-preset="180">3 min</button>
            <button type="button" data-preset="300">5 min</button>
            <button type="button" data-preset="600">10 min</button>
            <button type="button" data-preset="900">15 min</button>
            <button type="button" data-preset="1800">30 min</button>
          </div>
          <div class="timer-actions">
            <button class="timer-primary" id="countdown-start" type="button">Start</button>
            <button class="timer-secondary" id="countdown-reset" type="button">Reset</button>
          </div>
        </section>

        <section class="timer-panel" id="panel-stopwatch" role="tabpanel" hidden>
          <div class="timer-mode-heading">
            <div><span class="timer-kicker">TRACK ELAPSED TIME</span><h2>Stopwatch</h2></div>
            <span class="timer-status" id="stopwatch-status">Ready</span>
          </div>
          <div class="timer-display stopwatch-display" id="stopwatch-display" aria-live="off">00:00:00.00</div>
          <div class="timer-actions">
            <button class="timer-primary" id="stopwatch-start" type="button">Start</button>
            <button class="timer-secondary" id="stopwatch-lap" type="button" disabled>Lap</button>
            <button class="timer-secondary" id="stopwatch-reset" type="button">Reset</button>
          </div>
          <div class="lap-section">
            <div class="lap-heading"><strong>Laps</strong><span id="lap-count">0 recorded</span></div>
            <ol id="lap-list" class="lap-list"><li class="lap-empty">Your laps will appear here.</li></ol>
          </div>
        </section>

        <section class="timer-panel" id="panel-interval" role="tabpanel" hidden>
          <div class="timer-mode-heading">
            <div><span class="timer-kicker">WORK AND RECOVER</span><h2>Interval timer</h2></div>
            <span class="timer-status" id="interval-status">Ready</span>
          </div>
          <div class="interval-phase" id="interval-phase">READY</div>
          <div class="timer-display" id="interval-display">00:30</div>
          <div class="interval-progress" aria-hidden="true"><span id="interval-progress"></span></div>
          <div class="interval-count"><strong id="interval-round">Round 1 of 8</strong><span id="interval-next">Next: Rest</span></div>
          <div class="interval-settings">
            <label>Rounds<input id="interval-rounds" type="number" min="1" max="50" value="8" /></label>
            <label>Work · sec<input id="interval-work" type="number" min="1" max="3600" value="30" /></label>
            <label>Rest · sec<input id="interval-rest" type="number" min="0" max="3600" value="15" /></label>
          </div>
          <div class="timer-presets">
            <button type="button" data-interval-preset="tabata">Tabata · 8 × 20/10</button>
            <button type="button" data-interval-preset="30-15">30 / 15 · 8 rounds</button>
            <button type="button" data-interval-preset="45-15">45 / 15 · 6 rounds</button>
          </div>
          <div class="timer-actions">
            <button class="timer-primary" id="interval-start" type="button">Start intervals</button>
            <button class="timer-secondary" id="interval-reset" type="button">Reset</button>
          </div>
        </section>

        <label class="timer-sound">
          <input id="timer-sound" type="checkbox" checked />
          Play a short sound when a timer changes or finishes
        </label>
      </section>

      <p class="timer-tip">Tip: keep your phone volume on. Timing is deadline-based, so it stays accurate if you switch tabs and catches up when you return.</p>
    </div>

    <div slot="aside">
      <div class="ig-card aside-card" data-account-slot></div>
      <div class="ig-card aside-card">
        <p class="aside-title">Ways to use it</p>
        <div class="aside-list">
          <div class="aside-item"><span aria-hidden="true">⏱</span><span>Rest between sets<small>Countdown with presets</small></span></div>
          <div class="aside-item"><span aria-hidden="true">◷</span><span>Track a session<small>Stopwatch with lap splits</small></span></div>
          <div class="aside-item"><span aria-hidden="true">⇄</span><span>Conditioning<small>Work/rest rounds</small></span></div>
        </div>
      </div>
    </div>
  </AppChrome>

  <script>
    import "../scripts/timer";
  </script>
</Layout>
