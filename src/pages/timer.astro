---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Timer — Cal-Kie" description="A focused countdown, stopwatch and interval timer for your workouts and everyday tasks.">
<div class="app-shell timer-app">
  <header class="topbar">
    <a class="brand" href="/" aria-label="Cal-Kie home"><span class="brand-mark">CK</span><span>cal<span class="brand-accent">-kie</span></span></a>
    <div class="topbar-right"><a href="/timer" aria-current="page" style="display:inline-flex;align-items:center;padding:10px 13px;border:1px solid #596d4a;border-radius:11px;background:#202d24;color:#c6f36b;text-decoration:none;font-size:12px;font-weight:800">⏱ Timer</a><a class="timer-home-link" href="/">Home</a></div>
  </header>
  <main class="timer-page">
    <div class="timer-intro"><p class="eyebrow">FOCUS YOUR TIME</p><h1>Your time.<br/><em>Your pace.</em></h1><p>Count down a rest period, track a session or run your own work-and-rest intervals.</p></div>
    <section class="timer-card" aria-label="Timer tools">
      <div class="timer-tabs" role="tablist" aria-label="Choose timer">
        <button type="button" class="timer-tab active" data-mode="countdown" role="tab" aria-selected="true">Countdown</button>
        <button type="button" class="timer-tab" data-mode="stopwatch" role="tab" aria-selected="false">Stopwatch</button>
        <button type="button" class="timer-tab" data-mode="interval" role="tab" aria-selected="false">Intervals</button>
      </div>
      <section class="timer-panel" id="panel-countdown" role="tabpanel">
        <div class="timer-mode-heading"><div><span class="timer-kicker">SET A DURATION</span><h2>Countdown timer</h2></div><span class="timer-status" id="countdown-status">Ready</span></div>
        <div class="timer-display" id="countdown-display" aria-live="off">05:00</div>
        <div class="timer-inputs"><label>Minutes<input id="countdown-minutes" type="number" min="0" max="599" value="5" inputmode="numeric"/></label><span>:</span><label>Seconds<input id="countdown-seconds" type="number" min="0" max="59" value="0" inputmode="numeric"/></label></div>
        <div class="timer-presets" aria-label="Quick durations"><button type="button" data-preset="60">1 min</button><button type="button" data-preset="180">3 min</button><button type="button" data-preset="300">5 min</button><button type="button" data-preset="600">10 min</button><button type="button" data-preset="900">15 min</button><button type="button" data-preset="1800">30 min</button></div>
        <div class="timer-actions"><button class="timer-primary" id="countdown-start" type="button">Start</button><button class="timer-secondary" id="countdown-reset" type="button">Reset</button></div>
      </section>
      <section class="timer-panel" id="panel-stopwatch" role="tabpanel" hidden>
        <div class="timer-mode-heading"><div><span class="timer-kicker">TRACK ELAPSED TIME</span><h2>Stopwatch</h2></div><span class="timer-status" id="stopwatch-status">Ready</span></div>
        <div class="timer-display stopwatch-display" id="stopwatch-display" aria-live="off">00:00:00.00</div>
        <div class="timer-actions"><button class="timer-primary" id="stopwatch-start" type="button">Start</button><button class="timer-secondary" id="stopwatch-lap" type="button" disabled>Lap</button><button class="timer-secondary" id="stopwatch-reset" type="button">Reset</button></div>
        <div class="lap-section"><div class="lap-heading"><strong>Laps</strong><span id="lap-count">0 recorded</span></div><ol id="lap-list" class="lap-list"><li class="lap-empty">Your laps will appear here.</li></ol></div>
      </section>
      <section class="timer-panel" id="panel-interval" role="tabpanel" hidden>
        <div class="timer-mode-heading"><div><span class="timer-kicker">WORK AND RECOVER</span><h2>Interval timer</h2></div><span class="timer-status" id="interval-status">Ready</span></div>
        <div class="interval-phase" id="interval-phase">READY</div><div class="timer-display" id="interval-display">00:30</div>
        <div class="interval-progress"><span id="interval-progress"></span></div>
        <div class="interval-count"><strong id="interval-round">Round 1 of 8</strong><span id="interval-next">Next: Rest</span></div>
        <div class="interval-settings"><label>Rounds<input id="interval-rounds" type="number" min="1" max="50" value="8"/></label><label>Work · sec<input id="interval-work" type="number" min="1" max="3600" value="30"/></label><label>Rest · sec<input id="interval-rest" type="number" min="0" max="3600" value="15"/></label></div>
        <div class="timer-presets"><button type="button" data-interval-preset="tabata">Tabata · 8 × 20/10</button><button type="button" data-interval-preset="30-15">30 / 15 · 8 rounds</button><button type="button" data-interval-preset="45-15">45 / 15 · 6 rounds</button></div>
        <div class="timer-actions"><button class="timer-primary" id="interval-start" type="button">Start intervals</button><button class="timer-secondary" id="interval-reset" type="button">Reset</button></div>
      </section>
      <label class="timer-sound"><input id="timer-sound" type="checkbox" checked/> Play a short sound when a timer changes or finishes</label>
    </section>
    <p class="timer-tip">Tip: keep your phone volume on. The timer keeps accurate time if you switch tabs, and updates when you return.</p>
  </main>
</div>
<script>import "../scripts/timer";</script>
<style>
.timer-page{width:min(900px,100%);margin:0 auto;padding:42px 24px 70px}.timer-intro{text-align:center;margin:12px auto 28px;max-width:580px}.timer-intro h1{font:800 clamp(42px,7vw,68px)/1.02 Manrope,sans-serif;letter-spacing:-3px;margin:0}.timer-intro h1 em{font-style:normal;color:var(--lime)}.timer-intro>p:last-child{color:#aebcaf;font-size:14px;line-height:1.7}.timer-card{max-width:700px;margin:auto;padding:22px;border:1px solid #405343;border-radius:22px;background:linear-gradient(145deg,#1b2820,#141e17);box-shadow:0 24px 70px #0004}.timer-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding:5px;border-radius:13px;background:#101812}.timer-tab{min-height:42px;border:1px solid transparent;border-radius:9px;background:transparent;color:#9aab9d;font-size:12px;font-weight:800}.timer-tab.active{background:#2a3a2c;border-color:#596d4a;color:var(--lime)}.timer-panel{padding:28px 12px 14px}.timer-panel[hidden]{display:none}.timer-mode-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.timer-kicker{color:#9aab9d;font-size:9px;font-weight:800;letter-spacing:1.7px}.timer-mode-heading h2{font:750 22px Manrope;margin:6px 0 0}.timer-status{padding:7px 10px;border:1px solid #405343;border-radius:30px;color:#b6c6b7;font-size:10px;font-weight:800}.timer-display{margin:26px 0 20px;text-align:center;color:#eaf4e8;font:800 clamp(58px,12vw,100px)/1 Manrope,sans-serif;letter-spacing:-5px;font-variant-numeric:tabular-nums;text-shadow:0 0 40px #c6f36b12}.stopwatch-display{font-size:clamp(44px,9vw,78px);letter-spacing:-3px}.timer-inputs{display:flex;align-items:end;justify-content:center;gap:10px}.timer-inputs label,.interval-settings label{display:grid;gap:7px;color:#aebcaf;font-size:10px;font-weight:700}.timer-inputs input,.interval-settings input{width:105px;min-height:43px;padding:9px 10px;border:1px solid #405143;border-radius:9px;background:#101812;color:#edf4ed;text-align:center;font-size:16px;font-weight:800}.timer-inputs>span{padding-bottom:12px;color:var(--lime);font-size:22px;font-weight:800}.timer-presets{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin:19px 0}.timer-presets button{padding:8px 11px;border:1px solid #405343;border-radius:8px;background:#202d24;color:#c5d3c4;font-size:10px;font-weight:700}.timer-presets button:hover{border-color:#9fca60;color:var(--lime)}.timer-actions{display:flex;justify-content:center;gap:10px;margin:22px 0 4px}.timer-primary,.timer-secondary{min-width:112px;min-height:44px;padding:11px 17px;border-radius:10px;font-size:12px;font-weight:800}.timer-primary{border:1px solid var(--lime);background:var(--lime);color:#172117}.timer-secondary{border:1px solid #405343;background:#202d24;color:#dce8dc}.timer-primary:disabled,.timer-secondary:disabled{opacity:.4;cursor:not-allowed}.lap-section{max-width:430px;margin:26px auto 0}.lap-heading{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #344638;color:#dce8dc;font-size:11px}.lap-heading span{color:#9aab9d}.lap-list{max-height:190px;overflow:auto;margin:0;padding:0;list-style:none}.lap-list li{display:flex;justify-content:space-between;padding:9px 4px;border-bottom:1px solid #ffffff0d;color:#c3d0c3;font-size:11px;font-variant-numeric:tabular-nums}.lap-list .lap-empty{justify-content:center;color:#809181}.interval-phase{text-align:center;margin:24px 0 -16px;color:var(--lime);font-size:12px;font-weight:900;letter-spacing:3px}.interval-progress{height:7px;max-width:420px;margin:0 auto 13px;overflow:hidden;border-radius:10px;background:#0e1710}.interval-progress span{display:block;width:0;height:100%;border-radius:10px;background:var(--lime);transition:width .1s linear}.interval-count{display:flex;justify-content:space-between;max-width:420px;margin:0 auto;color:#aebcaf;font-size:10px}.interval-settings{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin:23px 0 12px}.interval-settings input{width:92px}.timer-sound{display:flex;justify-content:center;align-items:center;gap:9px;padding:15px 0 3px;border-top:1px solid #ffffff12;color:#aebcaf;font-size:10px}.timer-sound input{accent-color:var(--lime);width:16px;height:16px}.timer-tip{max-width:650px;margin:18px auto;color:#8fa092;text-align:center;font-size:11px;line-height:1.7}.timer-home-link{color:#c6f36b;text-decoration:none;font-size:12px;font-weight:800}.timer-home-link:hover{text-decoration:underline}
@media(max-width:600px){.timer-page{padding:28px 12px 45px}.timer-card{padding:14px;border-radius:17px}.timer-panel{padding:23px 2px 12px}.timer-intro h1{letter-spacing:-2px}.timer-intro>p:last-child{font-size:13px}.timer-display{letter-spacing:-3px}.stopwatch-display{letter-spacing:-2px}.timer-inputs input{width:92px}.interval-settings{gap:8px}.interval-settings input{width:82px}.timer-primary,.timer-secondary{min-width:0;flex:1}.timer-presets button{padding:8px 9px}}
</style>
</Layout>
