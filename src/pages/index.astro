---
import Layout from "../layouts/Layout.astro";
import AppChrome from "../components/AppChrome.astro";

const days = [
  { short: "Mon", full: "Monday", code: "MO" },
  { short: "Tue", full: "Tuesday", code: "TU" },
  { short: "Wed", full: "Wednesday", code: "WE" },
  { short: "Thu", full: "Thursday", code: "TH" },
  { short: "Fri", full: "Friday", code: "FR" },
  { short: "Sat", full: "Saturday", code: "SA" },
  { short: "Sun", full: "Sunday", code: "SU" }
];
---

<Layout title="Cal-Kie — Your week, your workout">
  <AppChrome active="home">
    <section class="profile-card" aria-labelledby="profile-name">
      <div class="profile-avatar">
        <img src="/images/calkie-bunny.svg" alt="Cal-Kie bunny mascot" width="86" height="86" />
      </div>
      <div class="profile-body">
        <div class="profile-title">
          <h1 id="profile-name">cal-kie</h1>
          <a class="ig-btn ig-btn-primary" href="/workout-builder">Generate workout</a>
          <a class="ig-btn" href="/timer">Timer</a>
        </div>
        <ul class="profile-stats">
          <li><b>7</b>days planned</li>
          <li><b>5</b>training days</li>
          <li><b>60</b>min a session</li>
        </ul>
        <p class="profile-bio">
          <strong>Your week. Your kind of strong.</strong>
          A two-week dumbbell and bodyweight split with form cues and demos, plus an AI builder for a week that fits your life.
        </p>
      </div>
    </section>

    <div class="story-row" role="group" aria-label="Choose a training day">
      {days.map((day, index) => (
        <button
          class:list={["story", { "is-active": index === 0 }]}
          type="button"
          data-story-day={index}
          data-story-name={day.full}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span class="story-ring" aria-hidden="true"><span class="story-avatar">{day.code}</span></span>
          <span class="story-name">{day.short}</span>
        </button>
      ))}
    </div>

    <section class="routine-panel" id="two-week-routine" aria-labelledby="routine-title">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Two-week plan</p>
          <h2 id="routine-title">Today's session</h2>
          <p class="routine-intro">Push · Legs · Pull · Full Body. Tap a day above or pick one here.</p>
        </div>
        <div class="routine-selectors">
          <label>
            Week
            <select id="routine-week">
              <option value="1">Week 1</option>
              <option value="2">Week 2</option>
            </select>
          </label>
          <label>
            Day
            <select id="routine-day">
              {days.map((day, index) => <option value={index}>{day.full}</option>)}
            </select>
          </label>
        </div>
      </div>
      <div id="routine-content" class="routine-content" aria-live="polite"></div>
      <p class="routine-footnote">
        Week 1 practises technique and establishes weights. Week 2 adds reps or load only with good form. Repeat for 4–6 weeks and track progress; don't force weekly increases.
      </p>
    </section>

    <footer class="ig-footer">
      cal-kie · made to move with you.
      ExerciseDB demonstrations are fetched on demand and credited to AscendAPI. Demos you upload or link are saved to your account only.
    </footer>

    <div slot="aside">
      <div class="ig-card aside-card" data-account-slot></div>
      <div class="ig-card aside-card">
        <p class="aside-title">Quick start</p>
        <div class="aside-list">
          <a class="aside-item" href="/workout-builder">
            <span aria-hidden="true">✦</span>
            <span>Build my week<small>AI plan in a minute</small></span>
            <span class="aside-arrow" aria-hidden="true">›</span>
          </a>
          <a class="aside-item" href="/timer">
            <span aria-hidden="true">⏱</span>
            <span>Start a timer<small>Countdown, laps, intervals</small></span>
            <span class="aside-arrow" aria-hidden="true">›</span>
          </a>
          <a class="aside-item" href="/#two-week-routine">
            <span aria-hidden="true">▤</span>
            <span>Two-week routine<small>Push · legs · pull · full body</small></span>
            <span class="aside-arrow" aria-hidden="true">›</span>
          </a>
        </div>
      </div>
      <div class="ig-card aside-card">
        <p class="aside-title">Train with intent</p>
        <p class="profile-bio" style="margin-top:0">
          Leave 1–2 reps in reserve, keep rest honest and warm up before your first working set. Cal-Kie offers general fitness guidance, not medical advice.
        </p>
      </div>
    </div>
  </AppChrome>

  <script>
    const daySelect = document.getElementById("routine-day") as HTMLSelectElement | null;
    const weekSelect = document.getElementById("routine-week") as HTMLSelectElement | null;
    const stories = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-story-day]"));

    const syncStories = () => {
      const activeDay = Number(daySelect?.value ?? 0);
      for (const story of stories) {
        const selected = Number(story.dataset.storyDay) === activeDay;
        story.classList.toggle("is-active", selected);
        story.setAttribute("aria-pressed", String(selected));
      }
    };

    for (const story of stories) {
      story.addEventListener("click", () => {
        if (!daySelect) return;
        daySelect.value = story.dataset.storyDay || "0";
        daySelect.dispatchEvent(new Event("change", { bubbles: true }));
        story.scrollIntoView({ inline: "center", block: "nearest" });
        requestAnimationFrame(syncStories);
      });
    }

    daySelect?.addEventListener("change", () => requestAnimationFrame(syncStories));
    weekSelect?.addEventListener("change", () => requestAnimationFrame(syncStories));
    syncStories();
  </script>
</Layout>
